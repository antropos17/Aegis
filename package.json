{
  "name": "aegis",
  "version": "0.16.0-alpha",
  "description": "OS-level monitor for AI agents: observes processes, file access, and network activity on the local machine and attributes each event to an agent instance.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && node scripts/launch.js",
    "dev": "vite --config vite.frontend.config.ts --mode preview",
    "build:renderer": "vite build --config vite.frontend.config.ts",
    "build:demo": "vite build --config vite.frontend.config.ts --mode preview",
    "build": "electron-builder --publish never",
    "dist": "electron-builder --publish never",
    "format": "prettier --write 'src/**/*.{js,ts,svelte,css,html}' 'bench/**/*.{js,json}' '*.{js,ts,json}' 'frontend/observatory/**/*.{js,ts,svelte,css,html,json,mjs}'",
    "format:check": "prettier --check 'src/**/*.{js,ts,svelte,css,html}' 'bench/**/*.{js,json}' '*.{js,ts,json}' 'frontend/observatory/**/*.{js,ts,svelte,css,html,json,mjs}'",
    "lint": "npx eslint src/ tests/ scripts/ bench/ frontend/observatory/",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p frontend/observatory/tsconfig.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.renderer.json && svelte-check --tsconfig frontend/observatory/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:gate": "node scripts/verify-witness-gate.mjs",
    "verify:seq-gate": "node scripts/verify-sequence-gate.mjs",
    "counts:check": "node scripts/counts.js",
    "build:sidecar": "node scripts/build-sidecar.js",
    "bench:generation": "node scripts/bench-generation.js",
    "bench:run": "node bench/run.js",
    "bench:s1": "node bench/run.js --scenario S1-agent-lifecycle --arm A",
    "bench:score": "node bench/score.js",
    "bench:replay": "node bench/trace/bench-replay.js",
    "prepare": "husky",
    "frontend:dev": "vite --config vite.frontend.config.ts --mode preview",
    "frontend:build": "vite build --config vite.frontend.config.ts",
    "frontend:build:preview": "vite build --config vite.frontend.config.ts --mode preview",
    "frontend:check": "tsc --noEmit -p frontend/observatory/tsconfig.json && svelte-check --tsconfig frontend/observatory/tsconfig.json",
    "frontend:test": "node frontend/observatory/tests/check-build.mjs",
    "frontend:test:electron": "node frontend/observatory/tests/electron-smoke.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "src/**/*.{js,ts,svelte,css,html}": "prettier --write",
    "bench/**/*.{js,json}": "prettier --write",
    "./*.{js,ts,json}": "prettier --write",
    "frontend/observatory/**/*.{js,ts,svelte,css,html,json,mjs}": "prettier --write"
  },
  "build": {
    "appId": "com.aegis.oversight",
    "productName": "AEGIS - AI Monitoring & Threat Detection",
    "copyright": "Copyright © 2026 AEGIS Contributors",
    "beforeBuild": "scripts/electron-builder-before-build.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "build/sidecar",
          "to": "sidecar",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer/observatory.nsh",
      "installerIcon": "build/installer/installer.ico",
      "uninstallerIcon": "build/installer/installer.ico",
      "installerSidebar": "build/installer/sidebar.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp",
      "installerHeader": "build/installer/header.bmp",
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "keys/aegis-release-pubkey.pub",
      "src/main/**/*",
      "src/shared/**/*",
      "dist/renderer/**/*",
      "rules/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "antropos17",
        "repo": "Aegis"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antropos17/Aegis.git"
  },
  "homepage": "https://github.com/antropos17/Aegis",
  "bugs": {
    "url": "https://github.com/antropos17/Aegis/issues"
  },
  "author": "AEGIS Contributors",
  "license": "MIT",
  "keywords": [
    "ai-agent-security",
    "ai-agent-monitoring",
    "edr",
    "endpoint-detection",
    "ai-safety",
    "ai-oversight",
    "process-monitoring",
    "electron",
    "svelte",
    "typescript",
    "open-source",
    "openclaw",
    "mcp-security",
    "llm-agent-security"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^6.14.0",
    "chokidar": "^3.6.0",
    "electron-updater": "6.8.9",
    "js-yaml": "^5.4.1",
    "semver": "^7.7.4"
  },
  "overrides": {
    "picomatch@<=2.3.1": "^2.3.2"
  }
}
