<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(CedarLayoutFile)" Condition="Exists('$(CedarLayoutFile)')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>aegis-cedar-job-fixture</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>CEDAR_JOB_FIXTURE</DefineConstants>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Native.cs;RetentionJob.cs;OwnedJob.cs;Child.cs;Protocol.cs;Program.cs;Fixture.cs;Layout.cs" />
  </ItemGroup>
</Project>
